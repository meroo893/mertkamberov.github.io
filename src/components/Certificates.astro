---
import { certificates } from '../data/certificates';
---

<section id="certificates">
  <div class="container">
    <h2 class="prompt-heading">cat certs.txt</h2>
    <ul class="certs">
      {
        certificates.map((cert) => (
          <li class="certs__item">
            <span class="certs__name">
              {cert.link ? (
                <a href={cert.link} target="_blank" rel="noopener">
                  {cert.name}
                </a>
              ) : (
                cert.name
              )}
            </span>
            <span class="certs__issuer">{cert.issuer}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .certs {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }

  .certs__item {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.6rem 0.85rem;
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .certs__issuer {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--accent);
    white-space: nowrap;
  }

  @media (max-width: 480px) {
    .certs__item {
      flex-direction: column;
      gap: 0.15rem;
    }
  }
</style>
